pipeline {
    agent any
    
    tools {
        maven 'Maven'
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo '📥 Récupération du code source...'
                checkout scm
            }
        }
        
        stage('Compile') {
            steps {
                echo '🔨 Compilation...'
                sh 'mvn clean compile'
            }
        }
        
        stage('Test') {
            steps {
                echo '🧪 Tests (skipped)...'
                sh 'mvn test -DskipTests'
            }
        }
        
        stage('Package') {
            steps {
                echo '📦 Packaging...'
                sh 'mvn package -DskipTests'
            }
        }
        
        stage('Archive') {
            steps {
                echo '📂 Archivage des artifacts...'
                archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
            }
        }
    }
    
    post {
        success {
            echo '✅ Build réussi ! Artifact créé dans target/'
        }
        failure {
            echo '❌ Le build a échoué. Vérifiez les logs.'
        }
        always {
            echo '🏁 Pipeline terminé.'
        }
    }
}

